{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kernelchaos",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-02",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "kernelchaos.wildideazone.com", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOMS", "class_name": "GameRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] }
  ],
  "d1_databases": [
    {
      "binding": "STATS_DB",
      "database_name": "kernelchaos-stats",
      "database_id": "8c03480d-b1be-4469-ac2c-2ee88fe2db95",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
